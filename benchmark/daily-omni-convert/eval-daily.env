# eval-daily.env — 官方 bench/huawei 评测 daily-omni 的【本机环境配置】
# 用法: cd evaluation && EVAL_CONFIG=../../benchmark/daily-omni-convert/eval-daily.env ./run_all.sh --tasks daily-omni --smoke 2 --no-build
# 基于 benchmark/huawei-eval.env, 仅改 DATASET_DIR/ANNOTATION_PATH 指向转换产物。不改 evaluation/config.env。

# ---- 模型（只读预置）----
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_LLM}
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- 路径 ----
LLAMACPP_ROOT=/workspace/user_data/claude_code/minicpm-ascend-challenge/code/llama.cpp-omni
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-huawei/bin          # build-huawei 含退化修复的 daily-cli
ASCEND_ENV=/usr/local/Ascend/cann-9.1.0-beta.1/set_env.sh
EVAL_SEED=42

# ---- 算力卡（单 die：dev0=die0 可用，die1 不可用）----
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0

# ---- Ascend 红线 flag（README §6 强制）----
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

# ---- smoke（0=全量 1196 题）----
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120

# ---- 数据集（★ daily-omni 转换产物）----
ASSETS_DIR=/workspace/shared_assets/datasets
DATASET_DIR=/workspace/user_data/claude_code/minicpm-ascend-challenge/benchmark/daily-omni-data
ANNOTATION_PATH=${DATASET_DIR}/daily_omni.jsonl

# ---- Python（daily-omni pipeline 需 pandas/pyarrow/PIL/librosa/soundfile → venv-omni）----
EVAL_PYTHON=/workspace/user_data/venv-omni/bin/python
RTS_PYTHON=/workspace/user_data/venv-omni/bin/python

# ---- 推理参数 ----
CTX_SIZE=40960
CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
