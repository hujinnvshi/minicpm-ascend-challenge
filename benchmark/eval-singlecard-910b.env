# benchmark/eval-singlecard-910b.env — 官方评测【单卡 910B 适配】环境配置（评审/复现标准入口）
# 2026-08-21 review-optimize 重写：适配官方 b06198f 新 schema（EVAL_CONFIG 替换语义，
#   必须继承官方 config.env 全部新键 RTS_*/VIDEOMME_SAMPLE_RATIO 等，否则 rts 任务缺键崩）
# 策略：source 官方 config.env 为基底（自动继承新键默认值），再覆盖本机路径/设备/数据。
# 用法: cd code/llama.cpp-omni/evaluation \
#       && EVAL_CONFIG=../../../benchmark/eval-singlecard-910b.env ./run_all.sh --tasks rts --smoke 2 --no-build
# 注: 不修改 evaluation/config.env（保持 immutable/可校验）；EVAL_CONFIG 覆盖机制（run_all.sh L42）。
# 注2: source 官方文件要求 EVAL_SUITE_ROOT 已导出（run_all.sh 会做）；单独 source 本文件时先 export 之。

# ---- 0. 基底：官方 config.env（新 schema 全键默认值）----
# EVAL_SUITE_ROOT 兜底（run_all.sh 已 export；直接 source 时用相对定位）
export EVAL_SUITE_ROOT="${EVAL_SUITE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../code/llama.cpp-omni/evaluation" && pwd)}"
# shellcheck disable=SC1091
source "${EVAL_SUITE_ROOT}/config.env"

# ---- 1. 模型（只读预置，共享区）----
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_LLM}
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- 2. 路径（2026-08-21 迁移后新工作区）----
LLAMACPP_ROOT=/workspace/minicpm-ascend-challenge/code/llama.cpp-omni
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-cann/bin          # 评测 binary（ccec build，含归帧溯源）
ASCEND_ENV=/usr/local/Ascend/cann-9.1.0-beta.3/set_env.sh
EVAL_SEED=42

# ---- 3. 算力卡（910B 双 die：必须锁 die0;dev1 在 RoPE aclnn_repeat_interleave 崩 exit139）----
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0
RTS_DEVICE_IDS=
RTS_DEVICE_COUNT=1
ASCEND_RT_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0
NUM_GPUS=1

# ---- 4. Ascend 红线 flag ----
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

# ---- 5. smoke（0=全量）----
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120
RTS_MIN_CORE_FRAMES=3

# ---- 6. 数据集（全量;子集/视频解压见 scripts/setup-videomme-videos.py）----
# 覆盖官方 ASSETS_DIR（默认 ${EVAL_SUITE_ROOT}/appendix）为共享区，但 TTS 打分权重走 appendix（本机软链已配）
ASSETS_DIR=/workspace/shared_assets/datasets
PARQUET_PATH=${ASSETS_DIR}/lmms-lab/Video-MME/videomme/test-00000-of-00001.parquet
VIDEO_DATA_DIR=${ASSETS_DIR}/lmms-lab/Video-MME/data         # 若缺失: python3 scripts/setup-videomme-videos.py --zip-dir ${ASSETS_DIR}/lmms-lab/Video-MME --out-dir ${VIDEO_DATA_DIR}
DATASET_DIR=/workspace/minicpm-ascend-challenge/benchmark/daily-omni-data
ANNOTATION_PATH=${DATASET_DIR}/daily_omni.jsonl
EVAL_DATA_PATH=${EVAL_SUITE_ROOT}/appendix/seedtts_testset_zh/zh
EVAL_META_PATH=${EVAL_DATA_PATH}/meta.lst
VIDEOMME_SAMPLE_RATIO=1

# ---- 7. RTS 自测输入（make_test_case.py 生成，gitignored）----
RTS_TEST_CASE_DIR=${EVAL_SUITE_ROOT}/judge-final/assets/test_case
RTS_VIDEO=${EVAL_SUITE_ROOT}/judge-final/assets/video/omni_duplex1.mp4
RTS_ASSIGNMENT_MODE=round_robin
RTS_ROTATION_ROUNDS=1
RTS_SEND_INTERVAL_S=1
RTS_PAD_BEFORE=0
RTS_PAD_AFTER=0
RTS_MODEL_LOAD_SLEEP_S=2
RTS_READY_TIMEOUT_S=300
RTS_MAX_RETRIES=0
RTS_BASE_PORT=19060

# ---- 8. TTS 打分模型（appendix 软链 → shared_assets；s3prl 在 user_data；paraformer 走 modelscope 缓存）----
PARAFORMER_MODEL=/root/.cache/modelscope/models/iic--speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch/snapshots/master
SPEAKER_CKPT=${EVAL_SUITE_ROOT}/appendix/wavlm_large_finetune.pth
S3PRL_REPO=/workspace/user_data/s3prl
WAVLM_LARGE_PT=${SPEAKER_CKPT}
ONNX_MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5/assets/token2wav

# ---- 9. Python（评测 venv）----
EVAL_PYTHON=/workspace/venv-g23/bin/python
RTS_PYTHON=/workspace/venv-g23/bin/python

# ---- 10. 推理参数 ----
CTX_SIZE=40960
CPP_NGL=999
TTS_DEVICE=cpu
SIM_DEVICE=cpu
WER_DEVICE=cpu
