# benchmark/eval-singlecard-910b.env — 官方评测【单卡 910B 适配】环境配置（评审/复现标准入口）
# 2026-08-14 review-optimize 修订：修正旧 huawei-eval.env 的过时路径（机器迁移后 LLAMACPP_ROOT/
#   ASCEND_ENV/CANN beta 版本/评测 binary 目录均已变化），并补齐 VISIBLE_DEVICES 双 die 锁 + NUM_GPUS=1。
# 用法: cd code/llama.cpp-omni/evaluation \
#       && EVAL_CONFIG=../../../benchmark/eval-singlecard-910b.env ./run_all.sh --tasks videomme --smoke 2 --no-build
# 注: 不修改 evaluation/config.env（保持 immutable/可校验）；通过 EVAL_CONFIG 覆盖（run_all.sh L42）。
#     子集对照（99q 协议对齐 A/B）用 diag/eval-99q-review.env。

# ---- 模型（只读预置）----
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_LLM}
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- 路径（当前机器, 2026-08-14 迁移后）----
LLAMACPP_ROOT=/workspace/user_data/temp_project/minicpm-ascend-challenge/code/llama.cpp-omni
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-cann/bin          # 当前评测 binary（ccec build, 含协议对齐门控）
ASCEND_ENV=/usr/local/Ascend/cann-9.1.0-beta.3/set_env.sh
EVAL_SEED=42

# ---- 算力卡（910B 双 die：必须锁 die0;dev1 在 RoPE aclnn_repeat_interleave 崩 exit139）----
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0
ASCEND_RT_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0
NUM_GPUS=1

# ---- Ascend 红线 flag ---- 
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

# ---- smoke（0=全量）----
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120

# ---- 数据集（全量;子集/视频解压见 scripts/setup-videomme-videos.py）----
ASSETS_DIR=/workspace/shared_assets/datasets
PARQUET_PATH=${ASSETS_DIR}/lmms-lab/Video-MME/videomme/test-00000-of-00001.parquet
VIDEO_DATA_DIR=${ASSETS_DIR}/lmms-lab/Video-MME/data         # 若缺失: python3 scripts/setup-videomme-videos.py --zip-dir ${ASSETS_DIR}/lmms-lab/Video-MME --out-dir ${VIDEO_DATA_DIR}

# ---- Python（评测 venv）----
EVAL_PYTHON=/workspace/venv-g23/bin/python
RTS_PYTHON=/workspace/venv-g23/bin/python

# ---- 推理参数 ----
CTX_SIZE=40960
CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu