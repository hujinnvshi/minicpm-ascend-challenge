# benchmark/eval-smoke-local.env — 本机快速自测（run_all.sh --smoke 2）配置
# 2026-08-21 重写：source eval-singlecard-910b.env（官方 b06198f schema 基底）+
#   数据路径覆盖为 99q 子集（快速、够验证链路，不预测成绩）
# 用法: cd code/llama.cpp-omni/evaluation \
#       && EVAL_CONFIG=../../../benchmark/eval-smoke-local.env ./run_all.sh --smoke 2 --no-build
# 注: 不修改 evaluation/config.env（EVAL_CONFIG 覆盖机制，合规）

# ---- 基底：单卡 910B 配置（含官方 config.env 全键继承）----
export EVAL_SUITE_ROOT="${EVAL_SUITE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../code/llama.cpp-omni/evaluation" && pwd)}"
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/eval-singlecard-910b.env"

# ---- 数据路径覆盖：99q 子集（快速冒烟，绝对路径）----
PARQUET_PATH=/workspace/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme_subset_99q.parquet
VIDEO_DATA_DIR=/workspace/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme99_data
# tts: 用 appendix 全量（同单卡）不覆盖
# rts: 样例视频已在 judge-final/assets/video/（官方默认），不覆盖

# ---- smoke 条数（0=全量）----
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
