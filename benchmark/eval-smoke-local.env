# benchmark/eval-smoke-local.env — 本机自测（run_all.sh --smoke 2）数据路径覆盖
# 基于 eval-singlecard-910b.env（算力/模型/路径）+ 4 任务数据映射到本机已有数据
# 用法: cd code/llama.cpp-omni/evaluation && EVAL_CONFIG=../../../benchmark/eval-smoke-local.env ./run_all.sh --smoke 2 --no-build
# 不修改 evaluation/config.env（EVAL_CONFIG 覆盖机制，合规）

# ---- 模型（同单卡适配）----
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_LLM}
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- 路径/算力（同单卡适配）----
LLAMACPP_ROOT=/workspace/user_data/temp_project/minicpm-ascend-challenge/code/llama.cpp-omni
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-cann/bin
ASCEND_ENV=/usr/local/Ascend/cann-9.1.0-beta.3/set_env.sh
EVAL_SEED=42
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0

# ---- 4 任务数据（本机已有）----
# videomme: 99q 子集 parquet + 33 视频
ASSETS_DIR=/workspace/user_data/temp_project/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag
PARQUET_PATH=${ASSETS_DIR}/videomme_subset_99q.parquet
VIDEO_DATA_DIR=${ASSETS_DIR}/videomme99_data
# daily-omni: 全量 1196 标注
DATASET_DIR=/workspace/user_data/temp_project/minicpm-ascend-challenge/benchmark/daily-omni-data
ANNOTATION_PATH=${DATASET_DIR}/daily_omni.jsonl
# tts: seedtts zh 测试集 + ONNX token2wav（本机）
EVAL_DATA_PATH=/workspace/user_data/seedtts_testset/zh
EVAL_META_PATH=${EVAL_DATA_PATH}/meta.lst
ONNX_MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5/assets/token2wav
# rts: 本机测试视频（官方 omni_duplex1.mp4 未下载，用 videomme 视频兜底）
RTS_VIDEO=/workspace/user_data/temp_project/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme99_data/0RxMZBLeqRI.mp4
