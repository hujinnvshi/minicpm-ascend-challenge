# benchmark/videomme-sampled010.env — Video-MME 官方确定性采样 0.1 复测（2026-08-21）
# 目的：官方 stratified_sampling 口径 vs 旧手动 270 合池（63.3%）对比
# 用法: cd code/llama.cpp-omni/evaluation \
#       && EVAL_CONFIG=../../../benchmark/videomme-sampled010.env ./run_all.sh --tasks videomme --no-build --full
# 注: 270 题 parquet 已按官方算法预采样；--sample-ratio 1.0 跑全量，避免双重采样
export EVAL_SUITE_ROOT="${EVAL_SUITE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../code/llama.cpp-omni/evaluation" && pwd)}"
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/eval-singlecard-910b.env"

# ---- Video-MME 采样路径覆盖 ----
PARQUET_PATH=/workspace/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme_sampled010.parquet
VIDEO_DATA_DIR=/workspace/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme_sampled010_data
VIDEOMME_SAMPLE_RATIO=1.0
SMOKE_VIDEOMME=0
