# eval-99q-review.env — D1 协议对齐 A/B 评测配置（review-optimize 分支）
# 用途: 99 题子集上对比【基线】(env 不设) vs 【完整协议对齐】(OMNI_IMAGE_ID=1 OMNI_TEXT_CHAT_SYS=1)
# 用法: cd code/llama.cpp-omni/evaluation && \
#       EVAL_CONFIG=../../../benchmark/video-mme-cookbook/diag/eval-99q-review.env \
#       OMNI_IMAGE_ID=1 OMNI_TEXT_CHAT_SYS=1 ./run_all.sh --tasks videomme --smoke 99 --no-build
# 基于旧 eval-99q.env 修正: 路径全部更新到当前机器 (2026-08-14 环境迁移) + CANN beta.3 + venv-g23

# ---- 模型（只读预置）----
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_LLM}
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- 路径（当前机器）----
LLAMACPP_ROOT=/workspace/user_data/temp_project/minicpm-ascend-challenge/code/llama.cpp-omni
# D1 用带 OMNI_IMAGE_ID/OMNI_TEXT_CHAT_SYS 门控的重编 binary（build-cann, 增量重建保证=当前源码）
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-cann/bin
ASCEND_ENV=/usr/local/Ascend/cann-9.1.0-beta.3/set_env.sh
EVAL_SEED=42

# ---- 算力卡（910B 双 die：必须锁 die0，dev1 在 RoPE aclnn_repeat_interleave 崩 exit139）----
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0
ASCEND_RT_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0
NUM_GPUS=1

# ---- Ascend 红线 flag ----
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

# ---- smoke ----
SMOKE_VIDEOMME=99
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120

# ---- 数据集（99q 子集 + 已解压视频, 见 diag/videomme99_data/ 33 mp4）----
ASSETS_DIR=/workspace/shared_assets/datasets
PARQUET_PATH=/workspace/user_data/temp_project/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme_subset_99q.parquet
VIDEO_DATA_DIR=/workspace/user_data/temp_project/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme99_data

# ---- Python ----
EVAL_PYTHON=/workspace/venv-g23/bin/python
RTS_PYTHON=/workspace/venv-g23/bin/python

# ---- 推理参数 ----
CTX_SIZE=40960
CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu