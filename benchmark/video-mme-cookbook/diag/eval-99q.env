# eval-99q.env — 临时:用官方 run_all.sh 跑【现有33视频=99题子集】
# 基于 benchmark/huawei-eval.env, 仅改 PARQUET_PATH 指向 99q 子集(分层 short/medium/long 各33)
# 不动 committed 的 huawei-eval.env(正式评测仍用全量 parquet)
# 用法: cd evaluation && EVAL_CONFIG=../../benchmark/video-mme-cookbook/diag/eval-99q.env ./run_all.sh --tasks videomme --smoke 99 --no-build

# ---- 模型（只读预置）----
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_LLM}
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- 路径 ----
LLAMACPP_ROOT=/workspace/user_data/claude_code/minicpm-ascend-challenge/code/llama.cpp-omni
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-huawei/bin
ASCEND_ENV=/usr/local/Ascend/cann-9.1.0-beta.1/set_env.sh
EVAL_SEED=42

# ---- 算力卡（单 die：dev0=die0 可用）----
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0

# ---- Ascend 红线 flag ----
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

# ---- smoke ----
SMOKE_VIDEOMME=99
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120

# ---- 数据集（★ PARQUET 指向 99q 子集；视频仍用已提取的 33 个）----
ASSETS_DIR=/workspace/shared_assets/datasets
PARQUET_PATH=/workspace/user_data/claude_code/minicpm-ascend-challenge/benchmark/video-mme-cookbook/diag/videomme_subset_99q.parquet
VIDEO_DATA_DIR=/workspace/user_data/verify-ascend-2026-08-10/videomme-data

# ---- Python ----
EVAL_PYTHON=/workspace/user_data/venv-omni/bin/python
RTS_PYTHON=/workspace/user_data/venv-omni/bin/python

# ---- 推理参数 ----
CTX_SIZE=40960
CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
