# run-tts.env — TTS-Seed 评测【本机环境配置】(覆盖 tts_seed/pipeline.env 默认)
# 用法: source /usr/local/Ascend/ascend-toolkit/set_env.sh; source venv-tts/bin/activate
#       cd evaluation/tts_seed && source ../../../benchmark/tts-seed-convert/run-tts.env
#       python smoke_test.py 3   或   bash run_tts_eval_cpp_zh.sh
# 官方 evaluation/ 不改; 仅覆盖路径+device(WER/SIM 走 CPU 绕过 verification.py 的 .cuda())

# ---- 框架/二进制 ----
LLAMA_OMNI_DIR=/workspace/user_data/claude_code/minicpm-ascend-challenge/code/llama.cpp-omni
CPP_BIN=$LLAMA_OMNI_DIR/build-huawei/bin/llama-omni-tts-eval
CPP_BUILD_LIB=$LLAMA_OMNI_DIR/build-huawei/bin
CUDA_RUNTIME_LIB=

# ---- 模型(GGUF 本机已有) ----
MODEL_PATH=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
TTS_MODEL_PATH=$MODEL_PATH/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- Step-Audio ONNX(★本机已有, prompt bundle 提取用) ----
ONNX_MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5/assets/token2wav

# ---- 测试集(解压后) ----
EVAL_DATA_PATH=/workspace/user_data/seedtts_testset/zh
EVAL_META_PATH=$EVAL_DATA_PATH/meta.lst

# ---- 打分模型 ----
PARAFORMER_MODEL=paraformer-zh   # funasr 首次自动从 modelscope 拉(~1GB)
SPEAKER_CKPT=/workspace/shared_assets/datasets/CowboyZ/seed-tts-eval/wavlm_large_finetune.pth
S3PRL_REPO=/workspace/user_data/s3prl

# ---- device(generate→NPU; WER/SIM→CPU 合规不改 evaluation/) ----
TTS_DEVICE=cpu
T2W_DEVICE=gpu:0
CPP_NGL=99
WER_DEVICE=cpu
SIM_DEVICE=cpu

export LLAMA_OMNI_DIR CPP_BIN CPP_BUILD_LIB MODEL_PATH TTS_MODEL_PATH ONNX_MODEL_DIR
export EVAL_DATA_PATH EVAL_META_PATH PARAFORMER_MODEL SPEAKER_CKPT S3PRL_REPO
export TTS_DEVICE T2W_DEVICE CPP_NGL WER_DEVICE SIM_DEVICE
