# benchmark/huawei-eval.env — 官方 bench/huawei 评测的【本机环境配置】
# 用法: cd evaluation && EVAL_CONFIG=../../benchmark/huawei-eval.env ./run_all.sh --tasks videomme --smoke 2 --no-build
# 注: 不修改 evaluation/config.env（保持 immutable/可校验）；通过 EVAL_CONFIG 覆盖（run_all.sh L42）。
# run_all.sh L47 `set -a; source` —— 所有变量导出；${VAR} 按顺序解析。

# ---- 模型（只读预置）----
MODEL_DIR=/workspace/shared_assets/models/OpenBMB/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_LLM}
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ---- 路径 ----
LLAMACPP_ROOT=/workspace/user_data/claude_code/minicpm-ascend-challenge/code/llama.cpp-omni
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-huawei/bin          # 我们 ccec+-lascendcl 预构建产物
ASCEND_ENV=/usr/local/Ascend/cann-9.1.0-beta.1/set_env.sh
EVAL_SEED=42

# ---- 算力卡（单 die：dev0=die0 可用，die1 不可用）----
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0

# ---- Ascend 红线 flag（README §6 强制）----
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

# ---- smoke（0=全量）----
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2
RTS_MAX_DURATION=120

# ---- 数据集（videomme 数据就绪；daily-omni/tts 待 Phase3/4）----
ASSETS_DIR=/workspace/shared_assets/datasets
PARQUET_PATH=/workspace/shared_assets/datasets/lmms-lab/Video-MME/videomme/test-00000-of-00001.parquet
VIDEO_DATA_DIR=/workspace/user_data/verify-ascend-2026-08-10/videomme-data   # 已提取含 fFjv93ACGo8 等（smoke 2 够用）

# ---- Python（videomme pipeline 需 pandas/pyarrow/PIL → venv-omni）----
EVAL_PYTHON=/workspace/user_data/venv-omni/bin/python
RTS_PYTHON=/workspace/user_data/venv-omni/bin/python

# ---- 推理参数 ----
CTX_SIZE=40960
CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
