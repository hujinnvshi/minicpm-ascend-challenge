# ===== 构建产物 =====
code/*/build*/
code/*/cmake-build-*/
code/*/.cache/

# ===== 实验输出（perf 报告在 docs/perf-reports/ 另行归档） =====
code/*/output_*/
code/*/tools/omni/output*/
code/*/tools/omni/logs/

# ===== 大体积示例数据（需要时从上游重新获取） =====
code/daily-omni/example_videos/
code/daily-omni/assets/

# ===== 权重文件 =====
*.gguf
*.safetensors
*.bin
# 例外：llama.cpp-omni 官方测试词表（编译/测试必需，非比赛权重）
!code/llama.cpp-omni/models/*.gguf

# ===== Python =====
__pycache__/
*.pyc

# ===== Node =====
node_modules/

# ===== 提交打包产物 =====
dist/
*.tar.gz
*.tgz

# ===== 本地敏感信息（永不提交） =====
.secrets.local
*.local
.DS_Store
*.swp
.idea/
.vscode/

# ===== 工具索引（CodeGraph 等本地生成，不入库） =====
.codegraph/

# ===== omni-cli 运行输出副产品（项目根，含 wav/log） =====
/tools/

# ===== capture-env 资源快照（运行副产品） =====
resource-*/

# G2 benchmark: extracted datasets + generated outputs (large, not for git)
benchmark/seed-tts-eval/seedtts_testset/
benchmark/seed-tts-eval/gen/
benchmark/**/tts_wav/
benchmark/demo-evidence/video_*/
# demo runtime self-regenerated certs (keep committed originals only)

# ASV/TTS eval 本地产物(大文件/本地配置, 不入 git)
benchmark/seed-tts-eval/sv/wavlm-large/
benchmark/video-mme-cookbook/.env
benchmark/video-mme-cookbook/log/
benchmark/video-mme/data/

# G2 benchmark: Daily-Omni 转换产物（684 mp4+wav + jsonl, ~2.7GB, 不入库）
benchmark/daily-omni-data/
